# SkillSetu X — Environment Configuration
# Copy this to .env and fill in your values

# ============================================================
# APP
# ============================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ============================================================
# DATABASE — Neon (PostgreSQL + pgvector)
# ============================================================
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/skillsetu?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/skillsetu?sslmode=require
# For Alembic migrations, use the unpooled connection
ALEMBIC_DATABASE_URL=${DATABASE_URL_UNPOOLED}

# ============================================================
# REDIS — Upstash
# ============================================================
REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# ============================================================
# FILE STORAGE — Cloudflare R2
# ============================================================
S3_ENDPOINT_URL=https://xxx.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx
S3_BUCKET_NAME=skillsetu-files
S3_REGION=auto

# ============================================================
# AUTH
# ============================================================
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx

# OTP
OTP_SECRET=change-me
OTP_EXPIRY_SECONDS=300

# ============================================================
# LLM — Groq (OpenAI-compatible, free tier: 14.4K tokens/min)
# Used ONLY for: extraction assist, explanation, drafting,
# summarizing, query interpretation. NEVER for scoring.
# ============================================================
LLM_PROVIDER=groq
LLM_API_KEY=gsk_xxx
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ============================================================
# PAYMENTS — Razorpay (Test Mode)
# ============================================================
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# ============================================================
# CELERY WORKERS
# ============================================================
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# ============================================================
# EMBEDDINGS
# ============================================================
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ============================================================
# OBSERVABILITY
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=skillsetu-api

# ============================================================
# DEPLOYMENT
# ============================================================
# Vercel (set in Vercel dashboard)
VERCEL_TOKEN=xxx

# Railway (set in Railway dashboard)
RAILWAY_TOKEN=xxx
