# Explicit opt-in configuration: set SKILLSETU_ENV_FILE to this copied file.
# Local development needs no environment file or cloud accounts.
ENVIRONMENT=development
DEMO_MODE=true
# DATABASE_URL=postgresql+asyncpg://skillsetu:password@localhost:5432/skillsetu
# For production set independent, random secrets of at least 32 characters:
# JWT_SECRET_KEY=
# VAULT_KEY=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional Adzuna India job search credentials. Keep both values server-side.
# Set ADZUNA_DAILY_CALL_LIMIT to a value from 1 to 250; local/demo default is 15.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_DAILY_CALL_LIMIT=15
# Local Gemini browser submission, started only after approving a run in the UI.
LOCAL_AUTO_APPLY_ENABLED=true
AUTOMATION_BROWSER_CHANNEL=msedge
